# ============================================================================
# TRADING FLOOR — 6 BOTS TELEGRAM + SALLE 3D + JOURNAL NOTION + MOTEUR LLM FR
# Copiez ce fichier en `.env` pour configurer vos clés.
# ============================================================================

# Mode d'exécution : strictement "paper"
TRADING_MODE=paper

# --- MOTEUR LLM LE MOINS CHER (Optionnel : modifiable aussi en direct sur le Board) ---
# 1. Google Gemini 2.5 Flash-Lite (Gratuit sur Google AI Studio : https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. Groq Cloud Llama 3.3 70B (Gratuit sur https://console.groq.com/keys)
GROQ_API_KEY=

# 3. DeepSeek V3 (~$0.14 / 1M tokens sur https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 4. OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# --- 6 BOTS TELEGRAM (via @BotFather, 1 par rôle dans le groupe "Trading Floor") ---
TG_TOKEN_LEAD=
TG_TOKEN_ANALYST=
TG_TOKEN_STRATEGIST=
TG_TOKEN_RISK=
TG_TOKEN_EXECUTION=
TG_TOKEN_REVIEWER=

# ID du groupe Telegram "Trading Floor" et votre ID utilisateur Telegram
TG_CHAT_ID=
TG_HUMAN_USER_ID=
TG_HUMAN_USERNAME=

# Paramètres par défaut (modifiables en direct sur le Board)
PAPER_EQUITY=10000
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SCAN_INTERVAL_MIN=15
MONITOR_INTERVAL_SEC=30
TICKET_TTL_MIN=60
TZ_NAME=Europe/Paris
UI_PORT=4080
